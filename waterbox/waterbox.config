{
  "coreName": "bsnes v115",
  "systemId": "SNES",
  "systemNames": {
    "SNES": "Super Nintendo"
  },
  "author": "byuu and the bsnes contributors; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-bsnes115",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "rom",
  "deterministic": true,
  "suggestSettings": true,
  "gameFirmware": true,
  "memoryLayoutMiB": [
    128,
    4,
    8,
    4,
    128
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. The game database is read once at boot (a few MiB while it is parsed); the cartridge, the picture processors' buffers and the chips' stacks stay.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame (256x224 normally, 512 wide in hi-res, 448 or 480 lines interlaced or with the overscan shown).",
    "width": 512,
    "height": 480,
    "virtualWidth": 293,
    "virtualHeight": 224,
    "vsyncNumerator": 21477272,
    "vsyncDenominator": 357366,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "rate": 44100,
    "get": "GetAudio"
  },
  "input": {
    "name": "SNES Controller",
    "picture": "pictures/snes-controller.png",
    "_comment": "index order is the wire format: Power (hard reset), Reset, P1..P5 pads (P2 to P5 on the multitap in the right port), then the mice, the Super Scope and the Justifiers. Wider than 64, so everything rides the SetButton channel; the mice and guns move by SetAxis, a movement each frame, as bsnes takes them. Which blocks are live follows the port settings.",
    "buttons": [
      "Power",
      "Reset",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Select",
      "P1 Start",
      "P1 Y",
      "P1 B",
      "P1 X",
      "P1 A",
      "P1 L",
      "P1 R",
      "P2 Up",

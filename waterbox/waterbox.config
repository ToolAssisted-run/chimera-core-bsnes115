      "P3 Down",
      "P3 Left",
      "P3 Right",
      "P3 Select",
      "P3 Start",
      "P3 Y",
      "P3 B",
      "P3 X",
      "P3 A",
      "P3 L",
      "P3 R",
      "P4 Up",
      "P4 Down",
      "P4 Left",

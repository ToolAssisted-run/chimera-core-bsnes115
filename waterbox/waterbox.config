  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".sfc": "SNES",
    ".smc": "SNES",
    ".gb": "SNES",
    ".gbc": "SNES"
  },
  "firmware": [
    {
      "id": "sgb1.sfc",
      "display": "firmware.sgb1",
      "description": "firmware.sgb1.about",
      "name": "Super Game Boy (World) (Rev 2).sfc",
      "size": 262144,
      "nameHints": [
        "super game boy",
        "sgb"
      ],
      "requiredWhen": {
        "all": [
          {
            "any": [
              {
                "slot": "game",
                "extension": "gb"
              },
              {
                "slot": "game",
                "extension": "gbc"
              }
            ]
          },
          {
            "not": {
              "setting": "superGameBoy",
              "is": "SGB2"
            }
          }
        ]
      }
    },
    {
      "id": "sgb1.boot.rom",
      "display": "firmware.sgb1_boot",
      "description": "firmware.sgb1_boot.about",
      "name": "sgb_boot.bin",
      "size": 256,
      "sha1": "AA2F50A77DFB4823DA96BA99309085A3C6278515",
      "requiredWhen": {
        "all": [
          {
            "any": [
              {
                "slot": "game",
                "extension": "gb"
              },
              {
                "slot": "game",
                "extension": "gbc"
              }
            ]
          },
          {
            "not": {
              "setting": "superGameBoy",
              "is": "SGB2"
            }
          }
        ]
      }
    },
    {
      "id": "sgb2.sfc",
      "display": "firmware.sgb2",
      "description": "firmware.sgb2.about",
      "name": "Super Game Boy 2 (Japan).sfc",
      "size": 524288,
      "nameHints": [
        "super game boy 2",
        "sgb2"
      ],
      "requiredWhen": {
        "all": [
          {
            "any": [
              {
                "slot": "game",
                "extension": "gb"
              },
              {
                "slot": "game",
                "extension": "gbc"
              }
            ]
          },
          {
            "setting": "superGameBoy",
            "is": "SGB2"
          }
        ]
      }
    },
    {
      "id": "sgb2.boot.rom",
      "display": "firmware.sgb2_boot",
      "description": "firmware.sgb2_boot.about",
      "name": "sgb2_boot.bin",
      "size": 256,
      "sha1": "93407EA10D2F30AB96A314D8ECA44FE160AEA734",
      "requiredWhen": {
        "all": [
          {
            "any": [
              {
                "slot": "game",
                "extension": "gb"
              },
              {
                "slot": "game",
                "extension": "gbc"
              }
            ]
          },
          {
            "setting": "superGameBoy",
            "is": "SGB2"
          }
        ]
      }
    }
  ],
  "settings": [
    {
      "name": "leftPort",
      "display": "setting.leftport",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse"
      ],
      "default": "gamepad",
      "description": "setting.leftport.about",
      "optionLabels": {
        "gamepad": "option.gamepad",
        "none": "option.none",
        "mouse": "option.mouse"
      }
    },
    {
      "name": "rightPort",
      "display": "setting.rightport",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "multitap",
        "superScope",
        "justifier",
        "justifiers"
      ],
      "default": "gamepad",
      "description": "setting.rightport.about",
      "optionLabels": {
        "gamepad": "option.gamepad",
        "none": "option.none",
        "mouse": "option.mouse",
        "multitap": "option.multitap",
        "superScope": "option.superscope",
        "justifier": "option.justifier",
        "justifiers": "option.justifiers"
      }
    },
    {
      "name": "region",
      "display": "setting.region",
      "type": "enum",
      "options": [
        "Auto",
        "NTSC",
        "PAL"
      ],
      "default": "Auto",
      "description": "setting.region.about",
      "optionLabels": {
        "Auto": "option.region_auto",
        "NTSC": "option.ntsc",
        "PAL": "option.pal"
      }
    },
    {
      "name": "superGameBoy",
      "display": "setting.supergameboy",
      "type": "enum",
      "options": [
        "SGB",
        "SGB2"
      ],
      "default": "SGB",
      "description": "setting.supergameboy.about",
      "optionLabels": {
        "SGB": "option.sgb1",
        "SGB2": "option.sgb2"
      }
    },
    {
      "name": "entropy",
      "display": "setting.entropy",
      "type": "enum",
      "options": [
        "Low",
        "None",
        "High"
      ],
      "default": "Low",
      "description": "setting.entropy.about",
      "optionLabels": {
        "Low": "option.entropy_low",
        "None": "option.entropy_none",
        "High": "option.entropy_high"
      }
    },
    {
      "name": "hotfixes",
      "display": "setting.hotfixes",
      "type": "bool",
      "default": true,
      "description": "setting.hotfixes.about"
    },
    {
      "name": "fastPPU",
      "display": "setting.fastppu",
      "type": "bool",
      "default": true,
      "description": "setting.fastppu.about"
    },
    {
      "name": "deinterlace",
      "display": "setting.deinterlace",
      "type": "bool",
      "default": true,
      "description": "setting.deinterlace.about"
    },
    {
      "name": "noSpriteLimit",
      "display": "setting.nospritelimit",
      "type": "bool",
      "default": false,
      "description": "setting.nospritelimit.about"
    },
    {
      "name": "noVRAMBlocking",
      "display": "setting.novramblocking",
      "type": "bool",
      "default": false,
      "description": "setting.novramblocking.about"
    },
    {
      "name": "fastDSP",
      "display": "setting.fastdsp",
      "type": "bool",
      "default": true,
      "description": "setting.fastdsp.about"
    },
    {
      "name": "cubicInterpolation",
      "display": "setting.cubic",
      "type": "bool",
      "default": false,
      "description": "setting.cubic.about"
    },
    {
      "name": "echoShadow",
      "display": "setting.echoshadow",
      "type": "bool",
      "default": false,
      "description": "setting.echoshadow.about"
    },
    {
      "name": "coprocessorDelayedSync",
      "display": "setting.delayedsync",
      "type": "bool",
      "default": true,
      "description": "setting.delayedsync.about"
    },
    {
      "name": "coprocessorPreferHLE",
      "display": "setting.preferhle",
      "type": "bool",
      "default": false,
      "description": "setting.preferhle.about"
    },
    {
      "name": "cpuOverclock",
      "display": "setting.cpuoverclock",
      "type": "uint",
      "default": 100,
      "min": 10,
      "max": 400,
      "description": "setting.cpuoverclock.about"
    },
    {
      "name": "cpuFastMath",
      "display": "setting.fastmath",
      "type": "bool",
      "default": false,
      "description": "setting.fastmath.about"
    },
    {
      "name": "sa1Overclock",
      "display": "setting.sa1overclock",
      "type": "uint",
      "default": 100,
      "min": 10,
      "max": 400,
      "description": "setting.sa1overclock.about"
    },
    {
      "name": "superFXOverclock",
      "display": "setting.superfxoverclock",
      "type": "uint",
      "default": 100,
      "min": 10,
      "max": 800,
      "description": "setting.superfxoverclock.about"
    },
    {
      "name": "showOverscan",
      "display": "setting.overscan",
      "type": "bool",
      "default": false,
      "description": "setting.overscan.about"
    }
  ]
}

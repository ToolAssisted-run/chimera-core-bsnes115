      "Scope Cursor",
      "Scope Turbo",
      "Scope Pause",
      "Justifier 1 Trigger",
      "Justifier 1 Start",
      "Justifier 2 Trigger",
      "Justifier 2 Start"
    ],
    "mnemonics": {
      "Power": "P",
      "Reset": "r",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Select": "s",
